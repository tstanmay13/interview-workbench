#!/bin/sh

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
ROOT_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
  printf 'Usage: %s demo.md [demo.html]\n' "$0" >&2
  exit 2
fi

SOURCE=$1
OUTPUT=${2:-${SOURCE%.md}.html}

if [ ! -f "$SOURCE" ]; then
  printf 'Demo source does not exist: %s\n' "$SOURCE" >&2
  exit 1
fi

OUTPUT_DIR=$(dirname "$OUTPUT")
if [ ! -d "$OUTPUT_DIR" ]; then
  printf 'Output directory does not exist: %s\n' "$OUTPUT_DIR" >&2
  exit 1
fi

TEMP_OUTPUT=$(mktemp "$OUTPUT.tmp.XXXXXX")
cleanup() { rm -f "$TEMP_OUTPUT"; }
trap cleanup EXIT HUP INT TERM

{
  sed -n '1,$p' "$ROOT_DIR/assets/demo-head.html"
  sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' "$SOURCE"
  sed -n '1,$p' "$ROOT_DIR/assets/demo-tail.html"
} > "$TEMP_OUTPUT"

mv "$TEMP_OUTPUT" "$OUTPUT"
trap - EXIT HUP INT TERM

printf 'Rendered %s\n' "$OUTPUT"
